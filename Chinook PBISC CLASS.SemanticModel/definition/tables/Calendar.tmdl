	partition Calendar = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR(Min(invoices[InvoiceDate]), MAX(invoices[InvoiceDate])),
				    "Year", YEAR([Date]),
				    "Month", MONTH([Date]),
				    "Day", DAY([Date]),
				    "MonthName", FORMAT([Date], "MMM"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Weekday", FORMAT([Date], "dddd"),
				    "MonthNumber", MONTH([Date]),
				    "DayNumber", WEEKDAY([Date], 2)
				)
				
				```

	annotation PBI_Id = 23f2487fe9ef4f98bb107ccc4f0e6984

